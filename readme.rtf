-- AUTH SERVICE\
-- =====================================\
\
DROP TABLE IF EXISTS users;\
\
CREATE TABLE users (\
    id BIGINT AUTO_INCREMENT PRIMARY KEY,\
    username VARCHAR(100) NOT NULL UNIQUE,\
    password VARCHAR(255) NOT NULL,\
    role VARCHAR(50) NOT NULL,\
    enabled BOOLEAN DEFAULT TRUE\
);\
